# Copy to functions/.env and fill in. Secrets (the Printify token and Stripe keys) are not
# set here; see the README for `firebase functions:secrets:set`.

# Your Printify shop's ID: the number in `GET https://api.printify.com/v1/shops.json`.
PRINTIFY_SHOP_ID=

# The site's public address, used for Stripe's return links.
SITE_URL=https://your-project.web.app

# Flat shipping charged at checkout, in cents.
FLAT_SHIPPING_CENTS=599

# Countries you ship to, comma-separated two-letter codes.
SHIP_COUNTRIES=US

# "true" sends each paid order straight to production at Printify.
# With "false", the Printify store's own order approval setting decides (new stores approve
# automatically after 24 hours; set it to Manual to review orders first).
AUTO_SEND_TO_PRODUCTION=false
