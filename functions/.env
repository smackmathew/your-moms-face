# Settings for the Cloud Functions. Nothing secret goes here: the Printify token and Stripe
# keys are set with `firebase functions:secrets:set` (see the README).

# The Printify API store the site sells from ("Your Moms Face Website", sales channel custom_integration).
PRINTIFY_SHOP_ID=29346122

# The site's public address, used for Stripe's return links. Leave it empty to use whatever
# address the customer is shopping on; set it (e.g. https://yourmomsface.com) to always send
# customers back to one address.
SITE_URL=

# Flat shipping charged at checkout, in cents.
FLAT_SHIPPING_CENTS=599

# Countries you ship to, comma-separated two-letter codes.
SHIP_COUNTRIES=US

# "true" sends each paid order straight to production at Printify.
# With "false", the Printify store's own order approval setting decides (new stores approve
# automatically after 24 hours; set it to Manual to review orders first).
AUTO_SEND_TO_PRODUCTION=false
